# Dependencies (match the directory AND a stray `node_modules` symlink — a
# trailing slash would only match a directory, letting a symlink slip through)
node_modules

# Build output
out/
dist/
release/

# Playwright (e2e) artifacts
test-results/
playwright-report/
blob-report/
/playwright/.cache/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Env / secrets
.env
.env.*
!.env.example

# Personal TODO tracking (per-user, never committed)
/TODO.md

# Claude Code session / worktree artifacts
.claude/
