# Dependencies (match the directory AND a stray `node_modules` symlink — a
# trailing slash would only match a directory, letting a symlink slip through)
node_modules

# Build output
out/
dist/
release/

# Generated from docs/houston-guide.md by scripts/gen-guide.mjs (postinstall,
# typecheck, lint, build, and vitest globalSetup all regenerate it). Committed
# until 2026-07: the whole guide lands on one ~37KB line, so every pair of
# concurrent PRs touching the guide conflicted there, unresolvably. Keep it out.
src/main/agent/guide-content.ts

# TypeScript incremental build cache (rewritten on every tsc/typecheck run)
*.tsbuildinfo

# Playwright (e2e) artifacts
test-results/
playwright-report/
blob-report/
/playwright/.cache/

# Wrangler local cache (from `npx wrangler pages dev website`)
.wrangler/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Env / secrets
.env
.env.*
!.env.example

# Personal TODO tracking (per-user, never committed)
/TODO.md

# Claude Code session / worktree artifacts
.claude/
