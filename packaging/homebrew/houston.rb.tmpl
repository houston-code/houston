# Generated by scripts/render-packaging.mjs from packaging/homebrew/houston.rb.tmpl in
# houston-code/houston. Edit the template there, not this file.
class Houston < Formula
  desc "Coding agent in your terminal: bring your own model"
  homepage "https://houstoncode.ai"
  url "https://github.com/houston-code/houston/releases/download/v{{VERSION}}/houston-cli.cjs"
  sha256 "{{SHA256}}"
  license "Apache-2.0"

  depends_on "node"

  def install
    libexec.install "houston-cli.cjs"
    # Node's on-disk compile cache spares recompiling the bundle on every start. A
    # NODE_COMPILE_CACHE the user set (even to empty) wins.
    cache_dir = if OS.mac?
      "$HOME/Library/Caches/houston/compile-cache"
    else
      "${XDG_CACHE_HOME:-$HOME/.cache}/houston/compile-cache"
    end
    (bin/"houston").write <<~SH
      #!/bin/bash
      if [ -z "${NODE_COMPILE_CACHE+set}" ]; then export NODE_COMPILE_CACHE="#{cache_dir}"; fi
      exec "#{formula_opt_bin("node")}/node" "#{libexec}/houston-cli.cjs" "$@"
    SH
  end

  test do
    assert_equal version.to_s, shell_output("#{bin}/houston --version").strip
  end
end
