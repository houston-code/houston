{
  "name": "houston",
  "version": "0.2.236",
  "description": "A coding agent desktop app for macOS, Windows, and Linux: bring your own model (Claude, GPT, Gemini, or a local LLM).",
  "author": {
    "name": "The Houston Authors",
    "email": "dev@houstoncode.ai"
  },
  "main": "./out/main/index.js",
  "bin": {
    "houston": "./out/cli/houston-cli.cjs"
  },
  "homepage": "https://github.com/piyushvijay/houston",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piyushvijay/houston.git"
  },
  "bugs": {
    "url": "https://github.com/piyushvijay/houston/issues"
  },
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "electron-rebuild --only node-pty && npm run gen:guide",
    "rebuild:native": "electron-rebuild --only node-pty",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "gen:guide": "node scripts/gen-guide.mjs",
    "build": "npm run gen:guide && npm run typecheck && electron-vite build",
    "build:cli": "npm run gen:guide && node scripts/build-cli.mjs",
    "install:cli": "npm run build:cli && node scripts/install-cli.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "pretypecheck": "npm run gen:guide",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "prelint": "npm run gen:guide",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "goldens:update": "vitest run src/main/agent/golden.test.ts -u",
    "eval": "vitest run --project evals",
    "eval:baseline": "HOUSTON_EVAL_LIVE=1 HOUSTON_EVAL_RECORD=1 vitest run --project evals",
    "notices": "node scripts/generate-notices.mjs",
    "license-gate": "node scripts/license-gate.mjs",
    "test:e2e": "npm run build && playwright test",
    "icon": "node scripts/make-icon.mjs && bash scripts/make-icns.sh",
    "verify:resources": "node scripts/verify-bundled-binaries.mjs",
    "dist": "npm run build && npm run verify:resources && electron-builder --mac --arm64",
    "dist:mac": "npm run build && npm run verify:resources && electron-builder --mac --arm64",
    "dist:mac:x64": "npm run build && npm run verify:resources -- --platform darwin --arch x64 && electron-builder --mac --x64",
    "dist:win": "npm run build && npm run verify:resources -- --platform win32 --arch x64 && electron-builder --win --x64",
    "dist:linux": "npm run build && npm run verify:resources -- --platform linux --arch x64 && electron-builder --linux --x64",
    "dist:unpacked": "npm run build && npm run verify:resources && electron-builder --mac --arm64 --dir"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.32.0",
    "@anthropic-ai/foundry-sdk": "^0.4.0",
    "@anthropic-ai/sdk": "^0.111.0",
    "@anthropic-ai/vertex-sdk": "^0.19.0",
    "@google/genai": "^2.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.3.9",
    "highlight.js": "^11.11.1",
    "minimatch": "^10.2.5",
    "node-pty": "^1.1.0",
    "openai": "^6.46.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.1",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/ripgrep": "^1.18.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^5.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
