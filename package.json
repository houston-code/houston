{
  "name": "houston",
  "version": "0.1.0",
  "description": "An open-source, local-first coding agent desktop app for macOS — bring your own model (Claude, GPT, Gemini, or a local LLM).",
  "author": "Houston contributors",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/piyushvijay/houston",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icon": "node scripts/make-icon.mjs && bash scripts/make-icns.sh",
    "dist": "npm run build && electron-builder --mac --arm64",
    "dist:unpacked": "npm run build && electron-builder --mac --arm64 --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@google/genai": "^2.9.0",
    "electron-updater": "^6.3.9",
    "minimatch": "^10.2.5",
    "openai": "^6.44.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/ripgrep": "^1.18.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^5.4.14",
    "vitest": "^2.1.8"
  }
}
